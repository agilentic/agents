// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © Volume-Price Divergence Accumulation/Distribution Indicator
// Detects quiet accumulation (LONG) and failed buying / distribution (SHORT) setups
// by identifying divergences between volume-side dominance and price behavior.

//@version=6
indicator("Volume-Price Divergence A/D",
     shorttitle = "VP Divergence",
     overlay    = true,
     max_labels_count = 500,
     max_bars_back = 500)

// ──────────────────────────────────────────────────────────────────────────────
// SECTION 1: USER INPUTS
// ──────────────────────────────────────────────────────────────────────────────

string group_vol    = "Volume Settings"
string group_price  = "Price Settings"
string group_signal = "Signal Settings"
string group_visual = "Visual Settings"

// --- Volume Settings ---
float rvol_threshold = input.float(1.2, "RVOL Threshold",
     minval   = 0.5,
     maxval   = 5.0,
     step     = 0.1,
     group    = group_vol,
     tooltip  = "Minimum relative volume ratio to consider volume as elevated. " +
                "1.2 means 20% above the baseline average. Higher = stricter filter.")

int weekly_length = input.int(5, "Weekly Period (bars)",
     minval  = 3,
     maxval  = 10,
     group   = group_vol,
     tooltip = "Number of recent bars to aggregate as the 'current week' window. " +
               "5 corresponds to one trading week on a daily chart.")

int baseline_weeks = input.int(4, "Baseline Weeks",
     minval  = 2,
     maxval  = 8,
     group   = group_vol,
     tooltip = "Number of prior weekly periods used to compute the baseline average volume. " +
               "4 means the average of the 4 weeks before the current week.")

float min_rvol_total = input.float(0.8, "Min Total RVOL",
     minval  = 0.1,
     step    = 0.1,
     group   = group_vol,
     tooltip = "Minimum total relative volume required for any signal. " +
               "Filters out signals on dead-volume stocks where data is unreliable.")

// --- Price Settings ---
int price_lookback = input.int(14, "Price Range Lookback",
     minval  = 5,
     maxval  = 50,
     group   = group_price,
     tooltip = "Number of bars to determine the high-low price range. " +
               "14 is roughly two trading weeks on a daily chart.")

float near_high_pct = input.float(0.80, "Near High Threshold",
     minval  = 0.5,
     maxval  = 0.95,
     step    = 0.05,
     group   = group_price,
     tooltip = "Price position must be at or above this level (0-1 scale) for a LONG signal. " +
               "0.80 means price is in the top 20% of its lookback range.")

float near_low_pct = input.float(0.20, "Near Low Threshold",
     minval  = 0.05,
     maxval  = 0.5,
     step    = 0.05,
     group   = group_price,
     tooltip = "Price position must be at or below this level (0-1 scale) for a SHORT signal. " +
               "0.20 means price is in the bottom 20% of its lookback range.")

// --- Signal Settings ---
float sell_dominance_min = input.float(0.55, "Min Sell Fraction (Long)",
     minval  = 0.50,
     maxval  = 0.75,
     step    = 0.01,
     group   = group_signal,
     tooltip = "Minimum fraction of weekly volume classified as selling for a LONG signal. " +
               "0.55 means sell volume must exceed 55% of total weekly volume.")

float buy_dominance_min = input.float(0.55, "Min Buy Fraction (Short)",
     minval  = 0.50,
     maxval  = 0.75,
     step    = 0.01,
     group   = group_signal,
     tooltip = "Minimum fraction of weekly volume classified as buying for a SHORT signal. " +
               "0.55 means buy volume must exceed 55% of total weekly volume.")

int cooldown_bars = input.int(5, "Signal Cooldown (bars)",
     minval  = 1,
     maxval  = 20,
     group   = group_signal,
     tooltip = "After a signal fires, suppress duplicate signals of the same type for this many bars. " +
               "Prevents label clutter during extended divergence periods.")

// --- Visual Settings ---
bool show_bar_colors = input.bool(true, "Color Signal Bars",
     group   = group_visual,
     tooltip = "When enabled, signal bars are colored green (LONG) or red (SHORT).")

bool show_bg_highlight = input.bool(true, "Show Background Tint",
     group   = group_visual,
     tooltip = "When enabled, a subtle background tint appears for the first 2 bars of each signal.")

bool show_info_table = input.bool(true, "Show Info Table",
     group   = group_visual,
     tooltip = "Display a persistent info table in the top-right corner showing current indicator values.")

bool show_rvol_plot = input.bool(true, "Show RVOL Histogram",
     group   = group_visual,
     tooltip = "Show the RVOL buy/sell histogram and price position line in the lower pane.")

// ──────────────────────────────────────────────────────────────────────────────
// SECTION 2: BUY / SELL VOLUME CLASSIFICATION
// ──────────────────────────────────────────────────────────────────────────────

// Approximate buy/sell split using bar's close position within its high-low range.
// Doji bars (high == low) get an even 50/50 split to avoid division by zero.
float bar_range    = high - low
bool  is_doji      = bar_range == 0.0
float buy_volume   = is_doji ? volume * 0.5 : volume * (close - low)  / bar_range
float sell_volume  = is_doji ? volume * 0.5 : volume * (high - close) / bar_range

// ──────────────────────────────────────────────────────────────────────────────
// SECTION 3: WEEKLY AGGREGATES (Current Window)
// ──────────────────────────────────────────────────────────────────────────────

float weekly_sell_vol  = math.sum(sell_volume, weekly_length)
float weekly_buy_vol   = math.sum(buy_volume,  weekly_length)
float weekly_total_vol = math.sum(volume,      weekly_length)

// ──────────────────────────────────────────────────────────────────────────────
// SECTION 4: BASELINE AVERAGES (Prior N Weeks, Excluding Current Window)
// ──────────────────────────────────────────────────────────────────────────────

// Total lookback = current week + baseline weeks.
// Baseline = (extended sum - current week) / baseline_weeks, giving the average
// weekly volume over the prior period without self-reference contamination.
int extended_length = weekly_length + weekly_length * baseline_weeks

float extended_sell_sum  = math.sum(sell_volume, extended_length)
float extended_buy_sum   = math.sum(buy_volume,  extended_length)
float extended_total_sum = math.sum(volume,      extended_length)

float baseline_sell_vol  = (extended_sell_sum  - weekly_sell_vol)  / baseline_weeks
float baseline_buy_vol   = (extended_buy_sum   - weekly_buy_vol)  / baseline_weeks
float baseline_total_vol = (extended_total_sum - weekly_total_vol) / baseline_weeks

// ──────────────────────────────────────────────────────────────────────────────
// SECTION 5: RELATIVE VOLUME (RVOL)
// ──────────────────────────────────────────────────────────────────────────────

// Safety: if baseline is near-zero (< 1), set RVOL to 0 to avoid
// misleading spikes from dividing by negligible volume.
float rvol_sell  = baseline_sell_vol  < 1.0 ? 0.0 : weekly_sell_vol  / baseline_sell_vol
float rvol_buy   = baseline_buy_vol   < 1.0 ? 0.0 : weekly_buy_vol   / baseline_buy_vol
float rvol_total = baseline_total_vol < 1.0 ? 0.0 : weekly_total_vol / baseline_total_vol

// ──────────────────────────────────────────────────────────────────────────────
// SECTION 6: PRICE POSITION WITHIN LOOKBACK RANGE
// ──────────────────────────────────────────────────────────────────────────────

float highest_n = ta.highest(high, price_lookback)
float lowest_n  = ta.lowest(low,   price_lookback)
float price_range = highest_n - lowest_n

// If the entire lookback range is flat (highest == lowest), price position is neutral 0.5.
float price_position = price_range == 0.0 ? 0.5 : (close - lowest_n) / price_range

// ──────────────────────────────────────────────────────────────────────────────
// SECTION 7: SELL / BUY DOMINANCE FRACTIONS
// ──────────────────────────────────────────────────────────────────────────────

float sell_fraction = weekly_total_vol > 0 ? weekly_sell_vol / weekly_total_vol : 0.0
float buy_fraction  = weekly_total_vol > 0 ? weekly_buy_vol  / weekly_total_vol : 0.0

// ──────────────────────────────────────────────────────────────────────────────
// SECTION 8: HISTORY GUARD
// ──────────────────────────────────────────────────────────────────────────────

// Suppress signals until we have enough bars for the full extended lookback.
// This prevents false signals from incomplete sums in the first bars of a chart.
bool has_enough_history = bar_index >= extended_length

// ──────────────────────────────────────────────────────────────────────────────
// SECTION 9: RAW SIGNAL CONDITIONS
// ──────────────────────────────────────────────────────────────────────────────

// LONG — "Quiet Resilience": heavy selling volume but price holds near highs.
bool raw_long = has_enough_history
     and rvol_sell > rvol_threshold
     and sell_fraction > sell_dominance_min
     and price_position >= near_high_pct
     and rvol_total > min_rvol_total

// SHORT — "Failed Buying": heavy buying volume but price stays pinned near lows.
bool raw_short = has_enough_history
     and rvol_buy > rvol_threshold
     and buy_fraction > buy_dominance_min
     and price_position <= near_low_pct
     and rvol_total > min_rvol_total

// ──────────────────────────────────────────────────────────────────────────────
// SECTION 10: COOLDOWN / DEDUPLICATION
// ──────────────────────────────────────────────────────────────────────────────

// Persistent counters track bars since last fired signal of each type.
// Signals are independent — a LONG cooldown does not block SHORT and vice versa.
var int long_cooldown_counter  = cooldown_bars + 1  // start past cooldown so first signal can fire
var int short_cooldown_counter = cooldown_bars + 1

long_cooldown_counter  := long_cooldown_counter  + 1
short_cooldown_counter := short_cooldown_counter + 1

bool long_signal  = raw_long  and long_cooldown_counter  > cooldown_bars
bool short_signal = raw_short and short_cooldown_counter > cooldown_bars

// Reset counters when a signal fires.
if long_signal
    long_cooldown_counter := 0

if short_signal
    short_cooldown_counter := 0

// ──────────────────────────────────────────────────────────────────────────────
// SECTION 11: SIGNAL LABELS ON CHART
// ──────────────────────────────────────────────────────────────────────────────

color color_long  = color.new(#00C853, 0)
color color_short = color.new(#FF1744, 0)

if long_signal
    label.new(bar_index, low, "LONG " + str.tostring(rvol_sell, "#.#") + "x",
         style     = label.style_label_up,
         color     = color_long,
         textcolor = color.white,
         size      = size.small,
         yloc      = yloc.belowbar)

if short_signal
    label.new(bar_index, high, "SHORT " + str.tostring(rvol_buy, "#.#") + "x",
         style     = label.style_label_down,
         color     = color_short,
         textcolor = color.white,
         size      = size.small,
         yloc      = yloc.abovebar)

// ──────────────────────────────────────────────────────────────────────────────
// SECTION 12: BACKGROUND HIGHLIGHT (First 2 Bars After Signal)
// ──────────────────────────────────────────────────────────────────────────────

// Track bars since signal for the 2-bar tint window.
var int bars_since_long  = 999
var int bars_since_short = 999

bars_since_long  := bars_since_long  + 1
bars_since_short := bars_since_short + 1

if long_signal
    bars_since_long := 0

if short_signal
    bars_since_short := 0

bool long_bg_active  = show_bg_highlight and bars_since_long  < 2
bool short_bg_active = show_bg_highlight and bars_since_short < 2

bgcolor(long_bg_active  ? color.new(#00C853, 90) : na)
bgcolor(short_bg_active ? color.new(#FF1744, 90) : na)

// ──────────────────────────────────────────────────────────────────────────────
// SECTION 13: BAR COLORING
// ──────────────────────────────────────────────────────────────────────────────

color bar_color = na
if show_bar_colors and long_signal
    bar_color := color_long
else if show_bar_colors and short_signal
    bar_color := color_short

barcolor(bar_color)

// ──────────────────────────────────────────────────────────────────────────────
// SECTION 14: RVOL HISTOGRAM & PRICE POSITION LINE (Lower Pane Plots)
// ──────────────────────────────────────────────────────────────────────────────

// RVOL sell is plotted as negative values to create a mirrored histogram.
// Visibility controlled by the user toggle — plot na when disabled.
float plot_rvol_buy  = show_rvol_plot ? rvol_buy          : na
float plot_rvol_sell = show_rvol_plot ? -rvol_sell         : na

plot(plot_rvol_buy,  "RVOL Buy",  color = color.new(#00BFA5, 30), style = plot.style_histogram, linewidth = 3)
plot(plot_rvol_sell, "RVOL Sell", color = color.new(#FF6D00, 30), style = plot.style_histogram, linewidth = 3)

// Threshold reference lines at +/- 1.2 (user's rvol_threshold).
float thresh_upper = show_rvol_plot ?  rvol_threshold : na
float thresh_lower = show_rvol_plot ? -rvol_threshold : na
plot(thresh_upper, "RVOL Upper Threshold", color = color.new(color.gray, 50), style = plot.style_line, linewidth = 1)
plot(thresh_lower, "RVOL Lower Threshold", color = color.new(color.gray, 50), style = plot.style_line, linewidth = 1)

// Price position (0-1) — plotted on a separate scale. Dynamically colored.
color pp_color = price_position > near_high_pct ? color.new(#00C853, 20) :
     price_position < near_low_pct  ? color.new(#FF1744, 20) :
     color.new(color.gray, 40)

plot(show_rvol_plot ? price_position : na, "Price Position", color = pp_color,
     style = plot.style_line, linewidth = 2)

// ──────────────────────────────────────────────────────────────────────────────
// SECTION 15: INFO TABLE (Top-Right Corner)
// ──────────────────────────────────────────────────────────────────────────────

var table info_tbl = table.new(position.top_right, columns = 2, rows = 5,
     bgcolor     = color.new(#1E1E1E, 10),
     border_width = 1,
     border_color = color.new(color.gray, 60),
     frame_width  = 1,
     frame_color  = color.new(color.gray, 60))

if show_info_table and barstate.islast
    // Row 0: RVOL Sell
    color rvol_sell_color = rvol_sell > rvol_threshold ? color.new(#00C853, 0) : color.gray
    table.cell(info_tbl, 0, 0, "RVOL Sell",
         text_color = color.white, text_size = size.small, bgcolor = color.new(#2A2A2A, 0))
    table.cell(info_tbl, 1, 0, str.tostring(rvol_sell, "#.##"),
         text_color = rvol_sell_color, text_size = size.small, bgcolor = color.new(#2A2A2A, 0))

    // Row 1: RVOL Buy
    color rvol_buy_color = rvol_buy > rvol_threshold ? color.new(#FF1744, 0) : color.gray
    table.cell(info_tbl, 0, 1, "RVOL Buy",
         text_color = color.white, text_size = size.small, bgcolor = color.new(#2A2A2A, 0))
    table.cell(info_tbl, 1, 1, str.tostring(rvol_buy, "#.##"),
         text_color = rvol_buy_color, text_size = size.small, bgcolor = color.new(#2A2A2A, 0))

    // Row 2: Price Position (as percentage)
    color pp_tbl_color = price_position >= near_high_pct ? color.new(#00C853, 0) :
         price_position <= near_low_pct ? color.new(#FF1744, 0) : color.gray
    table.cell(info_tbl, 0, 2, "Price Pos",
         text_color = color.white, text_size = size.small, bgcolor = color.new(#2A2A2A, 0))
    table.cell(info_tbl, 1, 2, str.tostring(price_position * 100, "#.#") + "%",
         text_color = pp_tbl_color, text_size = size.small, bgcolor = color.new(#2A2A2A, 0))

    // Row 3: Sell Dominance (as percentage)
    table.cell(info_tbl, 0, 3, "Sell Dom",
         text_color = color.white, text_size = size.small, bgcolor = color.new(#2A2A2A, 0))
    table.cell(info_tbl, 1, 3, str.tostring(sell_fraction * 100, "#.#") + "%",
         text_color = sell_fraction > sell_dominance_min ? color.new(#FF6D00, 0) : color.gray,
         text_size  = size.small, bgcolor = color.new(#2A2A2A, 0))

    // Row 4: Current Signal
    string signal_text  = long_signal ? "LONG" : short_signal ? "SHORT" : "NONE"
    color  signal_color = long_signal ? color.new(#00C853, 0) :
         short_signal ? color.new(#FF1744, 0) : color.gray
    table.cell(info_tbl, 0, 4, "Signal",
         text_color = color.white, text_size = size.small, bgcolor = color.new(#2A2A2A, 0))
    table.cell(info_tbl, 1, 4, signal_text,
         text_color = signal_color, text_size = size.small, bgcolor = color.new(#2A2A2A, 0))

// ──────────────────────────────────────────────────────────────────────────────
// SECTION 16: ALERT CONDITIONS
// ──────────────────────────────────────────────────────────────────────────────

alertcondition(long_signal,
     title   = "Accumulation Detected (Long)",
     message = "LONG: Selling RVOL={{rvol_sell}} but price at {{price_position}}% of range")

alertcondition(short_signal,
     title   = "Distribution Detected (Short)",
     message = "SHORT: Buying RVOL={{rvol_buy}} but price at {{price_position}}% of range")

alertcondition(long_signal or short_signal,
     title   = "Any Signal",
     message = "Volume-Price Divergence detected")
