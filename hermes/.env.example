# ── Hermes config ─────────────────────────────────────────
# Copy to .env and fill in. NEVER commit the real .env.

# Safety: true = log everything but post nothing. Flip ONLY after review.
HERMES_DRY_RUN=true

# Comma-separated keywords for mention monitoring
HERMES_KEYWORDS=AI agents,lead generation,social listening

# ── LLM (for drafting articles) ──────────────────────────
# Provider: openrouter | nous | openai
HERMES_LLM_PROVIDER=openrouter
HERMES_LLM_API_KEY=
HERMES_LLM_MODEL=anthropic/claude-sonnet-4-6

# ── X (Twitter) ──────────────────────────────────────────
# Bearer token (read-only mentions search, requires paid Basic $100/mo)
X_BEARER_TOKEN=
# OAuth1 user-context keys (for posting)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# ── LinkedIn ─────────────────────────────────────────────
# User-context OAuth2 token with w_member_social scope
LINKEDIN_ACCESS_TOKEN=
# Your actor URN, e.g. urn:li:person:abc123
LINKEDIN_ACTOR_URN=

# ── Instagram (Business/Creator only) ────────────────────
# Long-lived page token from Facebook Business
IG_ACCESS_TOKEN=
# IG Business account numeric ID (not username)
IG_USER_ID=

# ── Scheduling ───────────────────────────────────────────
HERMES_POLL_INTERVAL_MIN=15
HERMES_DRAFT_INTERVAL_HRS=6

# ── Storage ──────────────────────────────────────────────
# HERMES_DB_PATH=hermes.db
# HERMES_LOG_DIR=logs
